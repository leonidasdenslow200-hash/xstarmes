loadstring(game:HttpGet("-- VAPORWAVE DEV CONSOLE (ONE SCRIPT) -- LocalScript in StarterPlayerScripts  local Players = game:GetService("Players") local UIS = game:GetService("UserInputService") local RS = game:GetService("RunService") local TS = game:GetService("TweenService") local Workspace = game:GetService("Workspace") local Lighting = game:GetService("Lighting")  local LP = Players.LocalPlayer local PG = LP:WaitForChild("PlayerGui")  ---------------------------------------------------------------- -- THEME ---------------------------------------------------------------- local theme = {     BG = Color3.fromRGB(20, 10, 40),     Accent = Color3.fromRGB(255, 120, 200),     Accent2 = Color3.fromRGB(120, 200, 255),     Text = Color3.new(1,1,1) }  ---------------------------------------------------------------- -- ROOT GUI ---------------------------------------------------------------- local gui = Instance.new("ScreenGui") gui.Name = "VaporwaveConsole" gui.ResetOnSpawn = false gui.Parent = PG  ---------------------------------------------------------------- -- CONSOLE (SMALL, FLOATING, HIDDEN UNTIL UNLOCK) ---------------------------------------------------------------- local console = Instance.new("Frame") console.Size = UDim2.fromScale(0.24, 0.24) console.Position = UDim2.fromScale(0.72, 0.38) console.BackgroundColor3 = theme.BG console.BackgroundTransparency = 0.08 console.Active = true console.Draggable = true console.Visible = false console.Parent = gui Instance.new("UICorner", console).CornerRadius = UDim.new(0, 12) local stroke = Instance.new("UIStroke", console) stroke.Thickness = 2 stroke.Color = theme.Accent2  local gradient = Instance.new("UIGradient", console) gradient.Color = ColorSequence.new{     ColorSequenceKeypoint.new(0, theme.Accent),     ColorSequenceKeypoint.new(1, theme.Accent2) } gradient.Rotation = 45 gradient.Transparency = NumberSequence.new{     NumberSequenceKeypoint.new(0, 0.7),     NumberSequenceKeypoint.new(1, 0.7) }  local title = Instance.new("TextLabel") title.Size = UDim2.fromScale(1, 0.28) title.BackgroundTransparency = 1 title.Text = "VAPORWAVE CONSOLE" title.Font = Enum.Font.GothamBold title.TextScaled = true title.TextColor3 = theme.Text title.Parent = console  local status = Instance.new("TextLabel") status.Size = UDim2.fromScale(0.96, 0.2) status.Position = UDim2.fromScale(0.02, 0.28) status.BackgroundTransparency = 1 status.Text = "Locked. Enter password." status.Font = Enum.Font.Gotham status.TextScaled = true status.TextColor3 = theme.Text status.TextXAlignment = Enum.TextXAlignment.Left status.Parent = console  ---------------------------------------------------------------- -- TOAST ---------------------------------------------------------------- local function toast(msg)     local tGui = Instance.new("ScreenGui")     tGui.ResetOnSpawn = false     tGui.Parent = PG      local frame = Instance.new("Frame")     frame.Size = UDim2.fromScale(0.25, 0.08)     frame.Position = UDim2.fromScale(0.72, 1.1)     frame.BackgroundColor3 = theme.BG     frame.Parent = tGui     Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)     local s = Instance.new("UIStroke", frame)     s.Thickness = 2     s.Color = theme.Accent      local lbl = Instance.new("TextLabel")     lbl.Size = UDim2.fromScale(0.95, 1)     lbl.Position = UDim2.fromScale(0.025, 0)     lbl.BackgroundTransparency = 1     lbl.Text = msg     lbl.Font = Enum.Font.GothamBold     lbl.TextScaled = true     lbl.TextColor3 = theme.Text     lbl.Parent = frame      TS:Create(frame, TweenInfo.new(0.25), {Position = UDim2.fromScale(0.72, 0.86)}):Play()     task.delay(2.2, function()         TS:Create(frame, TweenInfo.new(0.25), {Position = UDim2.fromScale(0.72, 1.1)}):Play()         task.delay(0.3, function() tGui:Destroy() end)     end) end  ---------------------------------------------------------------- -- KEYPAD (CENTER) ---------------------------------------------------------------- local unlocked = false local PASSWORD = "6767" local currentInput = ""  local keypadFrame = Instance.new("Frame") keypadFrame.Size = UDim2.fromScale(0.3, 0.4) keypadFrame.Position = UDim2.fromScale(0.35, 0.3) keypadFrame.BackgroundColor3 = theme.BG keypadFrame.BackgroundTransparency = 0.05 keypadFrame.Parent = gui Instance.new("UICorner", keypadFrame).CornerRadius = UDim.new(0, 12) local kpStroke = Instance.new("UIStroke", keypadFrame) kpStroke.Thickness = 2 kpStroke.Color = theme.Accent2  local kpTitle = Instance.new("TextLabel") kpTitle.Size = UDim2.fromScale(1, 0.2) kpTitle.BackgroundTransparency = 1 kpTitle.Text = "ENTER PASSWORD" kpTitle.Font = Enum.Font.GothamBold kpTitle.TextScaled = true kpTitle.TextColor3 = theme.Text kpTitle.Parent = keypadFrame  local kpDisplay = Instance.new("TextLabel") kpDisplay.Size = UDim2.fromScale(0.9, 0.15) kpDisplay.Position = UDim2.fromScale(0.05, 0.2) kpDisplay.BackgroundTransparency = 0.3 kpDisplay.BackgroundColor3 = theme.BG kpDisplay.Font = Enum.Font.Code kpDisplay.TextScaled = true kpDisplay.TextColor3 = theme.Text kpDisplay.Text = "" kpDisplay.Parent = keypadFrame Instance.new("UICorner", kpDisplay).CornerRadius = UDim.new(0, 8)  local grid = Instance.new("Frame") grid.Size = UDim2.fromScale(0.9, 0.55) grid.Position = UDim2.fromScale(0.05, 0.4) grid.BackgroundTransparency = 1 grid.Parent = keypadFrame  local uiGrid = Instance.new("UIGridLayout") uiGrid.CellSize = UDim2.new(0.3, 0, 0.3, 0) uiGrid.CellPadding = UDim2.new(0.05, 0, 0.05, 0) uiGrid.FillDirectionMaxCells = 3 uiGrid.Parent = grid  local function makeKey(text, callback)     local btn = Instance.new("TextButton")     btn.BackgroundColor3 = theme.BG     btn.BackgroundTransparency = 0.2     btn.Text = text     btn.Font = Enum.Font.GothamBold     btn.TextScaled = true     btn.TextColor3 = theme.Text     btn.Parent = grid     Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)     btn.MouseButton1Click:Connect(callback) end  for i = 1, 9 do     makeKey(tostring(i), function()         if unlocked then return end         currentInput ..= tostring(i)         kpDisplay.Text = currentInput     end) end  makeKey("C", function()     if unlocked then return end     currentInput = ""     kpDisplay.Text = "" end)  makeKey("0", function()     if unlocked then return end     currentInput ..= "0"     kpDisplay.Text = currentInput end)  makeKey("OK", function()     if unlocked then return end     if currentInput == PASSWORD then         unlocked = true         console.Visible = true         keypadFrame:Destroy()         status.Text = "Password correct. Console unlocked. Type !cmds to view all commands."         toast("Password correct. Console unlocked. Type !cmds to view all commands.")     else         keypadFrame:Destroy()         toast("Wrong password. Access closed.")     end end)  ---------------------------------------------------------------- -- MOVEMENT HELPERS ---------------------------------------------------------------- local function getHumanoid()     local char = LP.Character     return char and char:FindFirstChildOfClass("Humanoid") end local function getHRP()     local char = LP.Character     return char and char:FindFirstChild("HumanoidRootPart") end  local flying = false local flySpeed = 60 local bv, bg  local function startFly()     if flying then return end     local hrp = getHRP()     if not hrp then status.Text = "No character."; return end     flying = true     bv = Instance.new("BodyVelocity")     bv.MaxForce = Vector3.new(1e5,1e5,1e5)     bv.Velocity = Vector3.new(0,0,0)     bv.Parent = hrp     bg = Instance.new("BodyGyro")     bg.MaxTorque = Vector3.new(1e5,1e5,1e5)     bg.CFrame = hrp.CFrame     bg.Parent = hrp     status.Text = "Fly ON"     toast("Fly ON") end  local function stopFly()     if not flying then return end     local hrp = getHRP()     if hrp then         if bv then bv:Destroy() bv = nil end         if bg then bg:Destroy() bg = nil end     end     flying = false     status.Text = "Fly OFF"     toast("Fly OFF") end  RS.RenderStepped:Connect(function()     if not flying then return end     local hrp = getHRP()     if not hrp then return end     local cam = Workspace.CurrentCamera     local move = Vector3.new()     if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end     if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end     if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end     if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end     if UIS:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0,1,0) end     if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.LeftShift) then move = move - Vector3.new(0,1,0) end     if move.Magnitude > 0 then         move = move.Unit * flySpeed     else         move = Vector3.new(0,0,0)     end     if bv then         bv.Velocity = move     end     if bg and Workspace.CurrentCamera then         bg.CFrame = Workspace.CurrentCamera.CFrame     end end)  ---------------------------------------------------------------- -- BIG COMMAND LIST UI (FOR !cmds) ---------------------------------------------------------------- local cmdsGui = Instance.new("ScreenGui") cmdsGui.Name = "CmdsListGui" cmdsGui.ResetOnSpawn = false cmdsGui.Enabled = false cmdsGui.Parent = PG  local cmdsFrame = Instance.new("Frame") cmdsFrame.Size = UDim2.fromScale(0.5, 0.6) cmdsFrame.Position = UDim2.fromScale(0.25, 0.2) cmdsFrame.BackgroundColor3 = theme.BG cmdsFrame.BackgroundTransparency = 0.05 cmdsFrame.Parent = cmdsGui Instance.new("UICorner", cmdsFrame).CornerRadius = UDim.new(0, 12) local cmdsStroke = Instance.new("UIStroke", cmdsFrame) cmdsStroke.Thickness = 2 cmdsStroke.Color = theme.Accent2  local cmdsTitle = Instance.new("TextLabel") cmdsTitle.Size = UDim2.fromScale(1, 0.12) cmdsTitle.BackgroundTransparency = 1 cmdsTitle.Text = "COMMANDS" cmdsTitle.Font = Enum.Font.GothamBold cmdsTitle.TextScaled = true cmdsTitle.TextColor3 = theme.Text cmdsTitle.Parent = cmdsFrame  local closeBtn = Instance.new("TextButton") closeBtn.Size = UDim2.fromScale(0.12, 0.12) closeBtn.Position = UDim2.fromScale(0.86, 0) closeBtn.BackgroundTransparency = 1 closeBtn.Text = "X" closeBtn.Font = Enum.Font.GothamBold closeBtn.TextScaled = true closeBtn.TextColor3 = theme.Accent2 closeBtn.Parent = cmdsFrame closeBtn.MouseButton1Click:Connect(function()     cmdsGui.Enabled = false end)  local cmdsScroll = Instance.new("ScrollingFrame") cmdsScroll.Size = UDim2.fromScale(0.96, 0.82) cmdsScroll.Position = UDim2.fromScale(0.02, 0.16) cmdsScroll.BackgroundColor3 = theme.BG cmdsScroll.BackgroundTransparency = 0.2 cmdsScroll.ScrollBarThickness = 6 cmdsScroll.CanvasSize = UDim2.new(0,0,0,0) cmdsScroll.Parent = cmdsFrame Instance.new("UICorner", cmdsScroll).CornerRadius = UDim.new(0, 8)  local cmdsLayout = Instance.new("UIListLayout") cmdsLayout.Parent = cmdsScroll cmdsLayout.SortOrder = Enum.SortOrder.LayoutOrder cmdsLayout.Padding = UDim.new(0, 4)  local function addCmdLine(text)     local lbl = Instance.new("TextLabel")     lbl.Size = UDim2.new(1, -10, 0, 24)     lbl.BackgroundTransparency = 1     lbl.Text = text     lbl.Font = Enum.Font.Code     lbl.TextSize = 16     lbl.TextColor3 = theme.Text     lbl.TextXAlignment = Enum.TextXAlignment.Left     lbl.Parent = cmdsScroll end  local function refreshCmdsList(commands)     for _, c in ipairs(cmdsScroll:GetChildren()) do         if c:IsA("TextLabel") then c:Destroy() end     end     local keys = {}     for k in pairs(commands) do table.insert(keys, k) end     table.sort(keys)     for _, k in ipairs(keys) do         local v = commands[k]         addCmdLine("!"..k.." - "..v.desc)     end     cmdsScroll.CanvasSize = UDim2.new(0,0,0,#keys * 26 + 20) end  ---------------------------------------------------------------- -- COMMAND BAR (ATTACHED TO CONSOLE, TOGGLED BY ;) ---------------------------------------------------------------- local cmdBar = Instance.new("TextBox") cmdBar.Size = UDim2.fromScale(0.96, 0.18) cmdBar.Position = UDim2.fromScale(0.02, 0.80) cmdBar.BackgroundColor3 = theme.BG cmdBar.BackgroundTransparency = 0.2 cmdBar.Text = "" cmdBar.PlaceholderText = "Type a command (e.g. !cmds) and press Enter..." cmdBar.Font = Enum.Font.Code cmdBar.TextScaled = true cmdBar.TextColor3 = theme.Text cmdBar.Visible = false cmdBar.Parent = console Instance.new("UICorner", cmdBar).CornerRadius = UDim.new(0, 8)  ---------------------------------------------------------------- -- COMMAND SYSTEM ---------------------------------------------------------------- local commands = {}  local function registerCommand(name, desc, func)     commands[name] = {desc = desc, fn = func} end  ---------------------------------------------------------------- -- REAL COMMANDS ---------------------------------------------------------------- registerCommand("help", "Short help in console.", function(args)     status.Text = "Use !cmds to see full list." end)  registerCommand("cmds", "Open big command list UI.", function(args)     refreshCmdsList(commands)     cmdsGui.Enabled = true     status.Text = "Command list opened." end)  registerCommand("speed", "Set WalkSpeed. !speed <number>", function(args)     local hum = getHumanoid()     if not hum then status.Text = "No humanoid."; return end     local n = tonumber(args[1])     if not n then status.Text = "Usage: !speed 32"; return end     hum.WalkSpeed = n     status.Text = "Speed set to "..n.."." end)  registerCommand("jump", "Set JumpPower. !jump <number>", function(args)     local hum = getHumanoid()     if not hum then status.Text = "No humanoid."; return end     local n = tonumber(args[1])     if not n then status.Text = "Usage: !jump 70"; return end     hum.JumpPower = n     status.Text = "JumpPower set to "..n.."." end)  registerCommand("fly", "Toggle classic fly.", function(args)     if flying then stopFly() else startFly() end end)  registerCommand("flash", "Screen flash.", function(args)     local f = Instance.new("Frame")     f.Size = UDim2.fromScale(1,1)     f.BackgroundColor3 = Color3.new(1,1,1)     f.BackgroundTransparency = 1     f.Parent = gui     TS:Create(f, TweenInfo.new(0.1), {BackgroundTransparency = 0.2}):Play()     task.delay(0.15, function()         TS:Create(f, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()         task.delay(0.3, function() f:Destroy() end)     end)     status.Text = "Flash." end)  registerCommand("shake", "Camera shake.", function(args)     local cam = Workspace.CurrentCamera     if not cam then return end     local orig = cam.CFrame     local t = 0     local dur = 0.5     while t < dur do         t += RS.RenderStepped:Wait()         local off = CFrame.new(             math.random(-2,2)/50,             math.random(-2,2)/50,             0         )         cam.CFrame = orig * off     end     cam.CFrame = orig     status.Text = "Shake." end)  registerCommand("confetti", "Confetti on your character.", function(args)     local hrp = getHRP()     if not hrp then status.Text = "No HRP."; return end     local p = Instance.new("ParticleEmitter")     p.Texture = "rbxassetid://241876969"     p.Lifetime = NumberRange.new(1)     p.Rate = 0     p.Speed = NumberRange.new(20)     p.Parent = hrp     p:Emit(200)     task.delay(1.2, function() p:Destroy() end)     status.Text = "Confetti." end)  registerCommand("notify", "Toast message. !notify <text>", function(args)     if #args == 0 then         status.Text = "Usage: !notify hello"         return     end     local msg = table.concat(args, " ")     toast(msg)     status.Text = "Notified." end)  registerCommand("setpoint", "Save current position.", function(args)     local hrp = getHRP()     if not hrp then status.Text = "No HRP."; return end     local pos = hrp.Position     local look = Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame.LookVector or Vector3.new(0,0,1)     LP:SetAttribute("VW_Pos", pos)     LP:SetAttribute("VW_Look", look)     status.Text = "Point saved."     toast("Point saved.") end)  registerCommand("tp", "Teleport to saved point.", function(args)     local hrp = getHRP()     if not hrp then status.Text = "No HRP."; return end     local pos = LP:GetAttribute("VW_Pos")     local look = LP:GetAttribute("VW_Look")     if not pos then status.Text = "No saved point."; return end     local cf     if look and typeof(look) == "Vector3" then         cf = CFrame.new(pos, pos + look)     else         cf = CFrame.new(pos)     end     hrp.CFrame = cf     status.Text = "Teleported."     toast("Teleported.") end)  registerCommand("ui", "Toggle console visibility.", function(args)     console.Visible = not console.Visible     status.Text = console.Visible and "Console visible." or "Console hidden." end)  -- removebarriers registerCommand("removebarriers", "Lets you walk through any model/part/asset except the ones you're standing on!", function(args)     local hrp = getHRP()     if not hrp then          status.Text = "No character."         return      end      local ignore = hrp      for _, obj in ipairs(workspace:GetDescendants()) do         if obj:IsA("BasePart") and obj ~= ignore then             obj.CanCollide = false         end     end      status.Text = "Barriers removed."     toast("Barriers removed.") end)  -- spawnmarker (visible to everyone) registerCommand("spawnmarker", "Creates a visible marker in Workspace.", function(args)     local hrp = getHRP()     if not hrp then status.Text = "No HRP."; return end     local p = Instance.new("Part")     p.Size = Vector3.new(2,2,2)     p.Color = theme.Accent     p.Anchored = true     p.Position = hrp.Position + Vector3.new(0,5,0)     p.Name = "DevMarker"     p.Parent = workspace     status.Text = "Marker spawned."     toast("Marker visible to all players.") end)  -- extra simple commands local function simpleCmd(name, desc)     registerCommand(name, desc, function()         status.Text = desc     end) end  simpleCmd("ping", "Ping check.") simpleCmd("version", "Dev console v1.0.") simpleCmd("about", "Vaporwave dev console.") simpleCmd("credits", "Made by you.") simpleCmd("clear", "Clear status.") commands["clear"].fn = function() status.Text = "" end  simpleCmd("time", "Show time.") commands["time"].fn = function() status.Text = "Time: "..os.date("%H:%M:%S") end  simpleCmd("date", "Show date.") commands["date"].fn = function() status.Text = "Date: "..os.date("%Y-%m-%d") end  simpleCmd("pos", "Show position.") commands["pos"].fn = function()     local hrp = getHRP()     if not hrp then status.Text = "No HRP."; return end     local p = hrp.Position     status.Text = ("Pos: %.1f, %.1f, %.1f"):format(p.X, p.Y, p.Z) end  simpleCmd("campos", "Show camera position.") commands["campos"].fn = function()     local cam = Workspace.CurrentCamera     if not cam then status.Text = "No camera."; return end     local p = cam.CFrame.Position     status.Text = ("Cam: %.1f, %.1f, %.1f"):format(p.X, p.Y, p.Z) end  simpleCmd("lighton", "Increase global brightness.") commands["lighton"].fn = function()     Lighting.Brightness = 3     status.Text = "Lighting increased." end  simpleCmd("lightoff", "Reset global brightness.") commands["lightoff"].fn = function()     Lighting.Brightness = 1     status.Text = "Lighting reset." end  simpleCmd("spawnlight", "Spawn a visible light orb.") commands["spawnlight"].fn = function()     local hrp = getHRP()     if not hrp then status.Text = "No HRP."; return end     local p = Instance.new("Part")     p.Shape = Enum.PartType.Ball     p.Size = Vector3.new(2,2,2)     p.Color = Color3.fromRGB(120,200,255)     p.Anchored = true     p.Position = hrp.Position + Vector3.new(0,6,0)     local light = Instance.new("PointLight", p)     light.Brightness = 5     light.Range = 15     p.Parent = workspace     status.Text = "Light orb spawned." end  simpleCmd("slowmo", "Slowmo (placeholder).") simpleCmd("fastmo", "Fastmo (placeholder).") simpleCmd("hudon", "HUD on (placeholder).") simpleCmd("hudoff", "HUD off (placeholder).") simpleCmd("debugon", "Debug on (placeholder).") simpleCmd("debugoff", "Debug off (placeholder).") simpleCmd("build", "Build mode (placeholder).") simpleCmd("nobuild", "Exit build mode (placeholder).")  registerCommand("echo", "Echo text.", function(args)     status.Text = "Echo: "..table.concat(args, " ") end)  ---------------------------------------------------------------- -- COMMAND EXECUTION (CHAT + CMD BAR USE SAME FUNCTION) ---------------------------------------------------------------- local function runCommandText(msg)     if not unlocked then return end     if type(msg) ~= "string" then return end     if msg:sub(1,1) ~= "!" then return end      local parts = {}     for w in msg:gmatch("%S+") do         table.insert(parts, w)     end     local rawCmd = parts[1]:sub(2):lower()     table.remove(parts, 1)     local cmd = commands[rawCmd]     if not cmd then         status.Text = "Unknown command: "..rawCmd         return     end     local ok, err = pcall(function()         cmd.fn(parts)     end)     if not ok then         status.Text = "Error: "..tostring(err)     end end  -- Chat listener LP.Chatted:Connect(runCommandText)  -- Command bar input cmdBar.FocusLost:Connect(function(enterPressed)     if not enterPressed then return end     local text = cmdBar.Text     cmdBar.Text = ""     runCommandText(text) end)  -- Toggle command bar with ; UIS.InputBegan:Connect(function(input, gp)     if gp then return end     if input.KeyCode == Enum.KeyCode.Semicolon then         if console.Visible then             cmdBar.Visible = not cmdBar.Visible             if cmdBar.Visible then                 cmdBar:CaptureFocus()             end         end     end end)",true))()
