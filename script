-- Save point: store as two attributes (Vector3 pos, Vector3 lookVector) to avoid loadstring
registerCommand("setpoint", "Save current position.", function(args)
    local hrp = getHRP()
    if not hrp then status.Text = "No HRP."; return end
    local pos = hrp.Position
    local look = Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame.LookVector or Vector3.new(0,0,1)
    LP:SetAttribute("VaporwaveSavedPointPos", pos)
    LP:SetAttribute("VaporwaveSavedPointLook", look)
    status.Text = "Point saved."
    toast("Point saved.")
end)

registerCommand("tp", "Teleport to saved point.", function(args)
    local hrp = getHRP()
    if not hrp then status.Text = "No HRP."; return end
    local pos = LP:GetAttribute("VaporwaveSavedPointPos")
    local look = LP:GetAttribute("VaporwaveSavedPointLook")
    if not pos then status.Text = "No saved point."; return end
    -- reconstruct CFrame using look vector if available
    local targetCFrame
    if look and typeof(look) == "Vector3" then
        targetCFrame = CFrame.new(pos, pos + look)
    else
        targetCFrame = CFrame.new(pos)
    end
    hrp.CFrame = targetCFrame
    status.Text = "Teleported."
    toast("Teleported.")
end)

