-- Chat listener
local function handleChat(msg)
    if type(msg) ~= "string" then return end
    if msg:sub(1,1) ~= "!" then return end
    local parts = {}
    for w in msg:gmatch("%S+") do
        table.insert(parts, w)
    end
    local rawCmd = parts[1]:sub(2):lower()
    table.remove(parts, 1)
    local cmd = commands[rawCmd]
    if not cmd then
        status.Text = "Unknown command: "..rawCmd
        return
    end
    local ok, err = pcall(function()
        cmd.fn(parts)
    end)
    if not ok then
        status.Text = "Error: "..tostring(err)
    end
end

LP.Chatted:Connect(handleChat)

