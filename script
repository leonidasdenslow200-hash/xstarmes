local function addESPForInstance(inst, label)
    if not inst then return end
    local target = nil
    if inst:IsA("Model") then
        target = inst.PrimaryPart or inst:FindFirstChild("HumanoidRootPart") or inst:FindFirstChildWhichIsA("BasePart")
    elseif inst:IsA("BasePart") then
        target = inst
    end
    if not target then return end
    if espItems[target] then return end
    local ador = makeAdornment(target, label)
    if ador then espItems[target] = ador end
end

local function removeESPForInstance(inst)
    if not inst then return end
    local target = inst.PrimaryPart or inst:FindFirstChild("HumanoidRootPart") or inst:FindFirstChildWhichIsA("BasePart") or inst
    local a = espItems[target]
    if a then a:Destroy() espItems[target] = nil end
end

-- Tag handlers
local function onNPCAdded(inst) addESPForInstance(inst, inst.Name or "NPC") end
local function onNPCRemoved(inst) removeESPForInstance(inst) end
local function onObjectAdded(inst) addESPForInstance(inst, inst.Name or "Object") end
local function onObjectRemoved(inst) removeESPForInstance(inst) end

for _, v in ipairs(CollectionService:GetTagged("DevESP_NPC")) do onNPCAdded(v) end
for _, v in ipairs(CollectionService:GetTagged("DevESP_Object")) do onObjectAdded(v) end

CollectionService:GetInstanceAddedSignal("DevESP_NPC"):Connect(onNPCAdded)
CollectionService:GetInstanceRemovedSignal("DevESP_NPC"):Connect(onNPCRemoved)
CollectionService:GetInstanceAddedSignal("DevESP_Object"):Connect(onObjectAdded)
CollectionService:GetInstanceRemovedSignal("DevESP_Object"):Connect(onObjectRemoved)

-- Target-assist (NPC only)
local function targetAssist()
    local hrp = getHRP()
    if not hrp then status.Text = "No character."; return end
    local myPos = hrp.Position
    local nearest, ndist = nil, math.huge
    for adornee, adorn in pairs(espItems) do
        local parent = adornee.Parent
        if parent and parent:FindFirstChildOfClass("Humanoid") then
            local pos = adornee.Position
            local d = (pos - myPos).Magnitude
            if d < ndist then
                nearest = adornee
                ndist = d
            end
        end
    end
    if nearest and ndist < 200 then
        local targetCFrame = CFrame.new(Workspace.CurrentCamera.CFrame.Position, nearest.Position)
        local t = 0
        local dur = 0.35
        local start = Workspace.CurrentCamera.CFrame
        while t < dur do
            local dt = RS.RenderStepped:Wait()
            t = t + dt
            local a = math.clamp(t/dur, 0, 1)
            Workspace.CurrentCamera.CFrame = start:Lerp(targetCFrame, a)
        end
        status.Text = "Targeted NPC."
        toast("Targeted NPC")
    else
        status.Text = "No NPC in range."
    end
end

-- Command system
local commands = {}

local function registerCommand(name, desc, func)
    commands[name] = {desc = desc, fn = func}
end

-- Populate help list function (robust)
local function populateHelp()
    -- remove all non-layout children
    for _, child in ipairs(helpFrame:GetChildren()) do
        if not child:IsA("UIListLayout") then child:Destroy() end
    end
    -- header
    addHelpLine("Commands:")
    -- stable ordering
    local keys = {}
    for k in pairs(commands) do table.insert(keys, k) end
    table.sort(keys)
    for _, k in ipairs(keys) do
        local v = commands[k]
        addHelpLine("  !"..k.."  -  "..v.desc)
    end
    -- player list
    addHelpLine("Players in game:")
    for _, p in ipairs(Players:GetPlayers()) do
        addHelpLine("  "..p.Name)
    end
    -- compute canvas size based on number of TextLabel children
    local labelCount = 0
    for _, child in ipairs(helpFrame:GetChildren()) do
        if child:IsA("TextLabel") then labelCount = labelCount + 1 end
    end
    helpFrame.CanvasSize = UDim2.new(0,0,0, math.max(1, labelCount) * 34)
end

